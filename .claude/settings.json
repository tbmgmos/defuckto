{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.mobileprovision)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(deploy/preview-server/com.defuckto.previewserver.plist)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(gh workflow *)",
      "Bash(./deploy/preview-server/publish-build.sh*)",
      "Bash(./deploy/preview-server/publish-web.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
